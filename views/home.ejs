<%- include('partials/header') %>

<section class="hero" aria-labelledby="home-heading">
  <h1 id="home-heading"><%= pageTitle %></h1>
  <p class="opening-times"><strong>Open every day, 9am - 6pm.</strong></p>
  <p>Explore underwater habitats, hands-on discoveries and conservation stories across our four themed zones.</p>
</section>

<img src="/images/divider.svg" alt="" class="divider">

<section class="search-section" aria-labelledby="search-heading">
  <h2 id="search-heading">Find an exhibit</h2>
  <label for="exhibit-search">Search exhibits</label>
  <input type="search" id="exhibit-search" placeholder="Try 'octopus' or 'reef'" autocomplete="off">
  <ul id="search-results" aria-live="polite" aria-busy="false"></ul>
</section>

<section class="zone-grid" aria-label="Aquarium zones">
  <% zones.forEach(zone => { %>
    <% const zoneAlt = {
      "coral-reef": "Colourful coral reef scene with tropical fish",
      "deep-ocean": "Deep ocean scene with a shark and octopus",
      "rainforest-river": "Tropical freshwater river scene with fish and plants",
      "rockpool-discovery": "Coastal rockpool scene with starfish and crabs"
    }[zone.slug] || `${zone.name} themed marine illustration`; %>
    <article class="zone-card">
      <img src="/images/zone-<%= zone.slug %>.svg" alt="<%= zoneAlt %>">
      <h2><%= zone.name %></h2>
      <p><%= zone.description %></p>
      <a href="/zone/<%= zone.slug %>">View details for <%= zone.name %></a>
    </article>
  <% }) %>
</section>

<script src="/js/search.js"></script>

<%- include('partials/footer') %>
